# =================================================================
# DebateAI — Environment Configuration
# =================================================================
# The application works out-of-the-box with ZERO API KEYS using its
# built-in Deterministic Oxford Collegiate Debater.
#
# To enable real cloud LLM generation, provide any ONE (or more) of
# the free API keys below:
# =================================================================

# 1. Groq Cloud (Recommended: Free tier, ultra-fast 400ms response time)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini (Free tier available on Google AI Studio)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI (Optional)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Backend Port (For standalone Express server)
PORT=5000
