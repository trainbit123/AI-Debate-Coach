# DebateAI — Environment Configuration Template

# NOTE: DebateAI operates 100% out-of-the-box with ZERO API KEYS required
# using its built-in collegiate Oxford debate engine and free DuckDuckGo/Wikipedia search.

# ==============================================================================
# Optional LLM API Keys (for enhanced generative arguments and deeper analysis)
# ==============================================================================
# Google Gemini API Key (Recommended)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key
# GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# Optional Dedicated Web Search Providers (for specialized commercial search index)
# ==============================================================================
# Tavily Search API (Recommended for AI research synthesis): https://tavily.com
# TAVILY_API_KEY=tvly-your_key_here

# Serper Google Search API: https://serper.dev
# SERPER_API_KEY=your_serper_key_here

# Port configuration (Defaults to 3000)
PORT=3000
